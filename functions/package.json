{
  "name": "workaxis-functions",
  "private": true,
  "description": "WorkAxis trusted backend: user provisioning, claims, attendance, kiosk pairing",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"lib/test/*.test.js\"",
    "test:rules": "node --test \"test-rules/*.test.mjs\"",
    "serve": "npm run build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "@types/node": "^20.0.0",
    "firebase": "^11.10.0",
    "typescript": "^5.5.0"
  }
}
