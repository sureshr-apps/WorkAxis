rules_version = '2';

// ===============================================================
// WorkAxis Firestore rules
// ===============================================================
//
// Identity model: SQL OrganizationMember is authoritative. These rules trust
// ONLY Firebase Auth custom claims, which are written exclusively by Cloud
// Functions (see docs/backend-api.md):
//   role           platformOwner | platformAdmin | orgAdmin | branchManager | employee
//   organizationId customer roles only
//   branchIds      list of branch ids (Branch Manager / Employee scope)
//   status         'active' | 'suspended'   (every helper requires 'active')
//
// Claims live in the ID token, which stays valid for up to an hour after a
// suspension or branch removal. Every helper therefore also checks the live
// users/{uid} projection (written by the same functions, first): its status,
// role and organization must agree with the token, and branch access needs
// the branch in both the token and the profile's activeBranchIds.
//
// Collections (all written by trusted functions unless stated):
//   user_aliases/{normalizedIdentifier} = { userId, email }   no client access
//   users/{uid}      read-only profile projection              clients read only
//   employee_private/{uid} = { organizationId, salary?, aadhaarNumber?,
//       aadhaarPhotoUrl?, updatedAt }  sensitive HR data; read by the active Org Admin
//       of that org, an assigned Branch Manager for employees in their branches,
//       and by the employee themself; platform roles denied
//   attendance_entries/{entryId}   self-service punches are written by the
//       recordAttendancePunch / recordGroupAttendance callables; managers
//       may only review existing entries in their scope
//   group_attendance_batches/{batchId}  immutable audit log
// Server-only (default deny): provision_requests, auth_rate_limits,
//   kiosk_pairing_tokens.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Claim helpers. Missing claims evaluate to deny.
    // ---------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    // The caller's live profile; a missing profile makes the caller inactive.
    function liveProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return signedIn() && request.auth.token.get('status', '') == 'active' &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        liveProfile().get('status', '') == 'active' &&
        liveProfile().get('role', '') == role() &&
        liveProfile().get('organizationId', '') == claimOrg();
    }

    function role() {
      return request.auth.token.get('role', '');
    }

    function claimOrg() {
      return request.auth.token.get('organizationId', '');
    }

    function claimBranches() {
      return request.auth.token.get('branchIds', []);
    }

    // Branch access from the live profile. Profiles written before
    // activeBranchIds existed fall back to branchIds until re-projected.
    function liveBranches() {
      return liveProfile().get('activeBranchIds', liveProfile().get('branchIds', []));
    }

    // In scope only while both the token and the live profile grant it.
    function managesBranch(branchId) {
      return branchId in claimBranches() && branchId in liveBranches();
    }

    function sharesManagedBranch(branchIds) {
      return branchIds.toSet()
        .intersection(claimBranches().toSet())
        .intersection(liveBranches().toSet())
        .size() > 0;
    }

    function isPlatform() {
      return isActive() && role() in ['platformOwner', 'platformAdmin'];
    }

    function isOrgAdminOf(orgId) {
      return isActive() && role() == 'orgAdmin' && claimOrg() != '' && claimOrg() == orgId;
    }

    function isBranchManagerOf(orgId, branchId) {
      return isActive() && role() == 'branchManager' &&
        claimOrg() != '' && claimOrg() == orgId &&
        managesBranch(branchId);
    }

    function isBranchManagerOfEmployee(orgId, userId) {
      let employeeProfile = get(
        /databases/$(database)/documents/users/$(userId)
      ).data;
      return isActive() && role() == 'branchManager' &&
        claimOrg() != '' && claimOrg() == orgId &&
        employeeProfile.get('organizationId', '') == orgId &&
        employeeProfile.get('role', '') == 'employee' &&
        sharesManagedBranch(employeeProfile.get('branchIds', []));
    }

    // Org Admin of the org, or Branch Manager of the branch.
    function canManageBranchData(orgId, branchId) {
      return isOrgAdminOf(orgId) || isBranchManagerOf(orgId, branchId);
    }

    // ---------------------------------------------------------------
    // Validation helpers
    // ---------------------------------------------------------------
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return (field in request.resource.data) &&
        request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    function isValidDateString(dateStr) {
      return dateStr is string && dateStr.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    // ---------------------------------------------------------------
    // Default deny
    // ---------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // 1. Login aliases: no client access at all. Identifier resolution
    //    goes through the resolveLoginIdentifier callable.
    // ---------------------------------------------------------------
    match /user_aliases/{aliasKey} {
      allow get, list, create, update, delete: if false;
    }

    // ---------------------------------------------------------------
    // 2. Users: read-only projection written by trusted functions.
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow get: if isActive() && (
        request.auth.uid == userId ||
        isPlatform() ||
        isOrgAdminOf(resource.data.get('organizationId', '')) ||
        (
          role() == 'branchManager' &&
          resource.data.get('organizationId', '') == claimOrg() &&
          resource.data.get('role', '') == 'employee' &&
          sharesManagedBranch(resource.data.get('branchIds', []))
        )
      );

      // Queries must be constrained (e.g. where organizationId == own org);
      // the same predicate is evaluated against each result document.
      allow list: if isActive() && (
        isPlatform() ||
        isOrgAdminOf(resource.data.get('organizationId', '')) ||
        (
          role() == 'branchManager' &&
          resource.data.get('organizationId', '') == claimOrg() &&
          resource.data.get('role', '') == 'employee' &&
          sharesManagedBranch(resource.data.get('branchIds', []))
        )
      );

      allow write: if false;
    }

    // ---------------------------------------------------------------
    // 2b. Employee private HR data (salary, Aadhaar). Written only by
    //     trusted functions. A Branch Manager may read it only for an employee
    //     assigned to one of their branches in the same organization.
    // ---------------------------------------------------------------
    match /employee_private/{userId} {
      allow get: if isActive() && (
        request.auth.uid == userId ||
        isOrgAdminOf(resource.data.get('organizationId', '')) ||
        isBranchManagerOfEmployee(
          resource.data.get('organizationId', ''), userId
        )
      );
      allow list, write: if false;
    }

    // ---------------------------------------------------------------
    // 3. Attendance entries
    // ---------------------------------------------------------------
    match /attendance_entries/{entryId} {
      // Platform roles: read-only. Org Admin: own org. Branch Manager: own
      // branches only. Employee: own entries.
      allow read: if isActive() && (
        isPlatform() ||
        isOrgAdminOf(resource.data.organizationId) ||
        isBranchManagerOf(resource.data.organizationId, resource.data.branchId) ||
        resource.data.employeeId == request.auth.uid
      );

      // Self-service punches are written by the recordAttendancePunch callable.
      // Group membership and effective time require authoritative SQL checks.
      allow create: if false; // Trusted recordGroupAttendance callable only.

      // Nobody reviews their own attendance (Branch Managers can have
      // entries when Branch Manager attendance is enabled).
      allow update: if canManageBranchData(resource.data.organizationId, resource.data.branchId) &&
        resource.data.employeeId != request.auth.uid &&
        isValidAttendanceReviewUpdate();

      allow delete: if false;
    }

    // Review updates may touch only the review fields; reviewedAt must be
    // server time and the reviewer must be the caller.
    function isValidAttendanceReviewUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reviewStatus', 'reviewedBy', 'reviewedById', 'reviewedAt']) &&
        request.resource.data.reviewStatus in ['none', 'pending', 'needsReview', 'verified', 'dismissed'] &&
        request.resource.data.reviewedById == request.auth.uid &&
        validStringLength('reviewedBy', 1, 100) &&
        request.resource.data.reviewedAt == request.time;
    }

    // Check-out correction requests: created and decided by the dataOp
    // callable (RequestCheckoutCorrection / ReviewCheckoutCorrection), which
    // updates the attendance entry in the same transaction.
    match /attendance_corrections/{correctionId} {
      allow read: if isActive() && (
        isPlatform() ||
        isOrgAdminOf(resource.data.organizationId) ||
        isBranchManagerOf(resource.data.organizationId, resource.data.branchId) ||
        resource.data.employeeId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------
    // 4. Group attendance batches (immutable audit log)
    // ---------------------------------------------------------------
    match /group_attendance_batches/{batchId} {
      allow read: if isActive() && (
        isPlatform() ||
        canManageBranchData(resource.data.organizationId, resource.data.branchId)
      );

      allow create: if false; // Audit records are created by the same transaction.

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // 5. Settings. Ranges mirror lib/features/settings SettingsValidators.
    // ---------------------------------------------------------------
    match /organization_settings/{orgId} {
      allow get: if isOrgAdminOf(orgId) || isPlatform();
      allow create, update: if isOrgAdminOf(orgId) &&
        isValidOrganizationSettings(request.resource.data, orgId);
      allow delete, list: if false;
    }

    match /platform_settings/{docId} {
      allow get: if docId == 'global' && isPlatform();
      allow create, update: if docId == 'global' &&
        isActive() && role() == 'platformOwner' &&
        isValidPlatformSettings(request.resource.data);
      allow delete, list: if false;
    }

    function isIntInRange(value, minValue, maxValue) {
      return value is int && value >= minValue && value <= maxValue;
    }

    function isValidOrganizationSettings(data, orgId) {
      return hasOnlyAllowedFields([
          'organizationId', 'geofenceRadiusMeters', 'gracePeriodMinutes',
          'allowBreaks', 'requireGeolocation', 'dailyDigest', 'returnAlerts',
          'requireEmployeeAssetAcknowledgement',
          'requireAttendanceSelfie',
          'requireBranchManagerAttendance',
          'payCalculationBasis', 'overtimeEnabled',
          'earlyCheckInMinutes', 'checkoutReminderMinutes',
          'overtimeReviewMinutes', 'maxSessionHours',
          'operationsEmail', 'emergencyPhone', 'updatedBy', 'updatedAt'
        ]) &&
        hasRequiredFields([
          'organizationId', 'geofenceRadiusMeters', 'gracePeriodMinutes',
          'allowBreaks', 'requireGeolocation', 'dailyDigest', 'returnAlerts',
          'updatedBy', 'updatedAt'
        ]) &&
        data.organizationId == orgId &&
        isIntInRange(data.geofenceRadiusMeters, 10, 5000) &&
        isIntInRange(data.gracePeriodMinutes, 0, 120) &&
        data.allowBreaks is bool &&
        data.requireGeolocation is bool &&
        data.dailyDigest is bool &&
        data.returnAlerts is bool &&
        (!('requireEmployeeAssetAcknowledgement' in data) ||
          data.requireEmployeeAssetAcknowledgement is bool) &&
        (!('requireAttendanceSelfie' in data) ||
          data.requireAttendanceSelfie is bool) &&
        (!('requireBranchManagerAttendance' in data) ||
          data.requireBranchManagerAttendance is bool) &&
        (!('payCalculationBasis' in data) ||
          data.payCalculationBasis in ['hours', 'workdays']) &&
        (!('overtimeEnabled' in data) || data.overtimeEnabled is bool) &&
        (!('earlyCheckInMinutes' in data) || isIntInRange(data.earlyCheckInMinutes, 0, 480)) &&
        (!('checkoutReminderMinutes' in data) || isIntInRange(data.checkoutReminderMinutes, 0, 240)) &&
        (!('overtimeReviewMinutes' in data) || isIntInRange(data.overtimeReviewMinutes, 0, 720)) &&
        (!('maxSessionHours' in data) || isIntInRange(data.maxSessionHours, 8, 24)) &&
        isValidOptionalString('operationsEmail', 3, 254) &&
        isValidOptionalString('emergencyPhone', 1, 32) &&
        data.updatedBy == request.auth.uid &&
        data.updatedAt == request.time;
    }

    function isValidPlatformSettings(data) {
      return hasOnlyAllowedFields([
          'sessionTimeoutMinutes', 'maxLoginAttempts', 'maintenanceMode',
          'enforceStrongPasswords', 'updatedBy', 'updatedAt'
        ]) &&
        hasRequiredFields([
          'sessionTimeoutMinutes', 'maxLoginAttempts', 'maintenanceMode',
          'enforceStrongPasswords', 'updatedBy', 'updatedAt'
        ]) &&
        isIntInRange(data.sessionTimeoutMinutes, 5, 1440) &&
        isIntInRange(data.maxLoginAttempts, 3, 10) &&
        data.maintenanceMode is bool &&
        data.enforceStrongPasswords is bool &&
        data.updatedBy == request.auth.uid &&
        data.updatedAt == request.time;
    }


  }
}
