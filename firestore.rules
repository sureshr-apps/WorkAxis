rules_version = '2';

// ===============================================================
// WorkAxis Firestore rules
// ===============================================================
//
// Identity model: SQL OrganizationMember is authoritative. These rules trust
// ONLY Firebase Auth custom claims, which are written exclusively by Cloud
// Functions (see docs/backend-api.md):
//   role           platformOwner | platformAdmin | orgAdmin | branchManager | employee
//   organizationId customer roles only
//   branchIds      list of branch ids (Branch Manager / Employee scope)
//   status         'active' | 'suspended'   (every helper requires 'active')
//
// Collections (all written by trusted functions unless stated):
//   user_aliases/{normalizedIdentifier} = { userId, email }   no client access
//   users/{uid}      read-only profile projection              clients read only
//   attendance_entries/{entryId}   employees' punches are written by the
//       recordAttendancePunch callable; managers may create group check-ins
//       (server time enforced) and review entries in their scope
//   group_attendance_batches/{batchId}  immutable audit log
// Server-only (default deny): provision_requests, auth_rate_limits,
//   kiosk_pairing_tokens.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Claim helpers. Missing claims evaluate to deny.
    // ---------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function isActive() {
      return signedIn() && request.auth.token.get('status', '') == 'active';
    }

    function role() {
      return request.auth.token.get('role', '');
    }

    function claimOrg() {
      return request.auth.token.get('organizationId', '');
    }

    function claimBranches() {
      return request.auth.token.get('branchIds', []);
    }

    function isPlatform() {
      return isActive() && role() in ['platformOwner', 'platformAdmin'];
    }

    function isOrgAdminOf(orgId) {
      return isActive() && role() == 'orgAdmin' && claimOrg() != '' && claimOrg() == orgId;
    }

    function isBranchManagerOf(orgId, branchId) {
      return isActive() && role() == 'branchManager' &&
        claimOrg() != '' && claimOrg() == orgId &&
        branchId in claimBranches();
    }

    // Org Admin of the org, or Branch Manager of the branch.
    function canManageBranchData(orgId, branchId) {
      return isOrgAdminOf(orgId) || isBranchManagerOf(orgId, branchId);
    }

    // ---------------------------------------------------------------
    // Validation helpers
    // ---------------------------------------------------------------
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return (field in request.resource.data) &&
        request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    function isValidDateString(dateStr) {
      return dateStr is string && dateStr.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    // ---------------------------------------------------------------
    // Default deny
    // ---------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // 1. Login aliases: no client access at all. Identifier resolution
    //    goes through the resolveLoginIdentifier callable.
    // ---------------------------------------------------------------
    match /user_aliases/{aliasKey} {
      allow get, list, create, update, delete: if false;
    }

    // ---------------------------------------------------------------
    // 2. Users: read-only projection written by trusted functions.
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow get: if isActive() && (
        request.auth.uid == userId ||
        isPlatform() ||
        isOrgAdminOf(resource.data.get('organizationId', '')) ||
        (
          role() == 'branchManager' &&
          resource.data.get('organizationId', '') == claimOrg() &&
          resource.data.get('role', '') == 'employee' &&
          resource.data.get('branchIds', []).hasAny(claimBranches())
        )
      );

      // Queries must be constrained (e.g. where organizationId == own org);
      // the same predicate is evaluated against each result document.
      allow list: if isActive() && (
        isPlatform() ||
        isOrgAdminOf(resource.data.get('organizationId', '')) ||
        (
          role() == 'branchManager' &&
          resource.data.get('organizationId', '') == claimOrg() &&
          resource.data.get('role', '') == 'employee' &&
          resource.data.get('branchIds', []).hasAny(claimBranches())
        )
      );

      allow write: if false;
    }

    // ---------------------------------------------------------------
    // 3. Attendance entries
    // ---------------------------------------------------------------
    match /attendance_entries/{entryId} {
      // Platform roles: read-only. Org Admin: own org. Branch Manager: own
      // branches only. Employee: own entries.
      allow read: if isActive() && (
        isPlatform() ||
        isOrgAdminOf(resource.data.organizationId) ||
        isBranchManagerOf(resource.data.organizationId, resource.data.branchId) ||
        resource.data.employeeId == request.auth.uid
      );

      // Employee punches are written by the recordAttendancePunch callable.
      // Managers may record group check-ins for their scope; timestamps must
      // be server time.
      allow create: if canManageBranchData(
          request.resource.data.organizationId, request.resource.data.branchId) &&
        isValidManagerEntry(request.resource.data);

      allow update: if canManageBranchData(resource.data.organizationId, resource.data.branchId) &&
        isValidAttendanceReviewUpdate();

      allow delete: if false;
    }

    function isValidManagerEntry(data) {
      return hasOnlyAllowedFields([
          'id', 'organizationId', 'branchId', 'employeeId', 'employeeName',
          'workDate', 'workDateString', 'status', 'reviewStatus', 'checkInAt',
          'note', 'kioskEntry', 'source', 'createdAt'
        ]) &&
        hasRequiredFields([
          'organizationId', 'branchId', 'employeeId', 'workDate',
          'workDateString', 'status', 'checkInAt', 'createdAt', 'source'
        ]) &&
        validStringLength('organizationId', 1, 100) &&
        validStringLength('branchId', 1, 100) &&
        validStringLength('employeeId', 1, 128) &&
        isValidOptionalString('employeeName', 1, 100) &&
        isValidOptionalString('note', 0, 1000) &&
        data.source == 'manager-group' &&
        data.status in ['present', 'late'] &&
        data.workDate is timestamp &&
        data.workDate <= request.time &&
        data.workDate > request.time - duration.value(7, 'd') &&
        isValidDateString(data.workDateString) &&
        data.checkInAt == request.time &&
        data.createdAt == request.time &&
        (!('reviewStatus' in data) || data.reviewStatus == 'none') &&
        (!('kioskEntry' in data) || data.kioskEntry == false);
    }

    // Review updates may touch only the review fields; reviewedAt must be
    // server time and the reviewer must be the caller.
    function isValidAttendanceReviewUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reviewStatus', 'reviewedBy', 'reviewedById', 'reviewedAt']) &&
        request.resource.data.reviewStatus in ['none', 'pending', 'needsReview', 'verified', 'dismissed'] &&
        request.resource.data.reviewedById == request.auth.uid &&
        validStringLength('reviewedBy', 1, 100) &&
        request.resource.data.reviewedAt == request.time;
    }

    // ---------------------------------------------------------------
    // 4. Group attendance batches (immutable audit log)
    // ---------------------------------------------------------------
    match /group_attendance_batches/{batchId} {
      allow read: if isActive() && (
        isPlatform() ||
        canManageBranchData(resource.data.organizationId, resource.data.branchId)
      );

      allow create: if canManageBranchData(
          request.resource.data.organizationId, request.resource.data.branchId) &&
        isValidGroupBatch(request.resource.data);

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // 5. Settings. Ranges mirror lib/features/settings SettingsValidators.
    // ---------------------------------------------------------------
    match /organization_settings/{orgId} {
      allow get: if isOrgAdminOf(orgId) || isPlatform();
      allow create, update: if isOrgAdminOf(orgId) &&
        isValidOrganizationSettings(request.resource.data, orgId);
      allow delete, list: if false;
    }

    match /platform_settings/{docId} {
      allow get: if docId == 'global' && isPlatform();
      allow create, update: if docId == 'global' &&
        isActive() && role() == 'platformOwner' &&
        isValidPlatformSettings(request.resource.data);
      allow delete, list: if false;
    }

    function isIntInRange(value, minValue, maxValue) {
      return value is int && value >= minValue && value <= maxValue;
    }

    function isValidOrganizationSettings(data, orgId) {
      return hasOnlyAllowedFields([
          'organizationId', 'geofenceRadiusMeters', 'gracePeriodMinutes',
          'allowBreaks', 'requireGeolocation', 'dailyDigest', 'returnAlerts',
          'operationsEmail', 'emergencyPhone', 'updatedBy', 'updatedAt'
        ]) &&
        hasRequiredFields([
          'organizationId', 'geofenceRadiusMeters', 'gracePeriodMinutes',
          'allowBreaks', 'requireGeolocation', 'dailyDigest', 'returnAlerts',
          'updatedBy', 'updatedAt'
        ]) &&
        data.organizationId == orgId &&
        isIntInRange(data.geofenceRadiusMeters, 10, 5000) &&
        isIntInRange(data.gracePeriodMinutes, 0, 120) &&
        data.allowBreaks is bool &&
        data.requireGeolocation is bool &&
        data.dailyDigest is bool &&
        data.returnAlerts is bool &&
        isValidOptionalString('operationsEmail', 3, 254) &&
        isValidOptionalString('emergencyPhone', 1, 32) &&
        data.updatedBy == request.auth.uid &&
        data.updatedAt == request.time;
    }

    function isValidPlatformSettings(data) {
      return hasOnlyAllowedFields([
          'sessionTimeoutMinutes', 'maxLoginAttempts', 'maintenanceMode',
          'enforceStrongPasswords', 'updatedBy', 'updatedAt'
        ]) &&
        hasRequiredFields([
          'sessionTimeoutMinutes', 'maxLoginAttempts', 'maintenanceMode',
          'enforceStrongPasswords', 'updatedBy', 'updatedAt'
        ]) &&
        isIntInRange(data.sessionTimeoutMinutes, 5, 1440) &&
        isIntInRange(data.maxLoginAttempts, 3, 10) &&
        data.maintenanceMode is bool &&
        data.enforceStrongPasswords is bool &&
        data.updatedBy == request.auth.uid &&
        data.updatedAt == request.time;
    }

    function isValidGroupBatch(data) {
      return hasOnlyAllowedFields([
          'id', 'organizationId', 'branchId', 'workDate', 'shiftName',
          'attendeeCount', 'createdBy', 'createdById', 'createdAt', 'note'
        ]) &&
        hasRequiredFields([
          'id', 'organizationId', 'branchId', 'workDate', 'shiftName',
          'attendeeCount', 'createdBy', 'createdById', 'createdAt'
        ]) &&
        validStringLength('id', 1, 128) &&
        validStringLength('organizationId', 1, 100) &&
        validStringLength('branchId', 1, 100) &&
        isValidDateString(data.workDate) &&
        validStringLength('shiftName', 1, 100) &&
        data.attendeeCount is int &&
        data.attendeeCount >= 0 &&
        data.attendeeCount <= 1000 &&
        validStringLength('createdBy', 1, 100) &&
        data.createdById == request.auth.uid &&
        data.createdAt == request.time &&
        isValidOptionalString('note', 0, 1000);
    }
  }
}
