rules_version = '2';

// Attachments are uploaded by the Flutter client (AttachmentStorage) and are
// immutable: every object gets a fresh UUID name, so only `create` is allowed.
// Claims (role, organizationId, branchIds, status) are written by trusted
// account functions. Attendance selfie reads are limited to assigned branches.
// Because an ID token outlives a suspension or branch removal by up to an
// hour, every check also reads the live Firestore users/{uid} profile (see
// firestore.rules): status, role and organization must match the token, and
// branch access needs the branch in both.
// Reads are `get` only: the app always opens an object by the reference saved
// on its record, so nobody may `list` a folder and enumerate other people's
// files (for example every Aadhaar scan in an organization).
service firebase.storage {
  match /b/{bucket}/o {
    function profilePath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }
    function liveProfile() {
      return firestore.get(profilePath()).data;
    }
    function active() {
      return request.auth != null && request.auth.token.status == 'active' &&
        firestore.exists(profilePath()) &&
        liveProfile().get('status', '') == 'active' &&
        liveProfile().get('role', '') == request.auth.token.role &&
        liveProfile().get('organizationId', '') ==
          request.auth.token.get('organizationId', '');
    }
    // The branch is granted by both the token and the live profile.
    function hasBranch(branchId) {
      return request.auth.token.get('branchIds', []).hasAny([branchId]) &&
        liveProfile().get('activeBranchIds', liveProfile().get('branchIds', []))
          .hasAny([branchId]);
    }
    function inOrg(orgId) {
      return active() && request.auth.token.organizationId == orgId;
    }
    function isOrgManager(orgId) {
      return inOrg(orgId) &&
        request.auth.token.role in ['orgAdmin', 'branchManager'];
    }
    function isOrgAdmin(orgId) {
      return inOrg(orgId) && request.auth.token.role == 'orgAdmin';
    }
    function isBranchManagerOf(orgId, branchId) {
      return inOrg(orgId) &&
        request.auth.token.role == 'branchManager' &&
        hasBranch(branchId);
    }
    function validImage() {
      return request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png)');
    }
    function platformStaff() {
      return active() && request.auth.token.role in ['platformOwner', 'platformAdmin'];
    }

    match /organizations/{orgId}/profile-photos/{file} {
      allow get: if inOrg(orgId);
      allow create: if isOrgManager(orgId) && validImage();
    }

    // Organization logos: uploaded by platform staff, read by the platform and
    // members of that organization. Uploads are immutable (fresh UUID names).
    match /organizations/{orgId}/logo/{file} {
      allow get: if platformStaff() || inOrg(orgId);
      allow create: if platformStaff() && request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png)');
    }

    // Identity documents: organization managers only.
    match /organizations/{orgId}/aadhaar-documents/{file} {
      allow get: if isOrgManager(orgId);
      allow create: if isOrgManager(orgId) && validImage();
    }

    // Attendance selfies are uploaded only to the caller's own branch/user
    // path. The punch callable checks the Branch Manager setting before saving
    // a punch; branch managers assigned to the path's branch and Org Admins
    // can review the images.
    match /organizations/{orgId}/attendance-selfies/{branchId}/{employeeUid}/{file} {
      allow get: if isOrgAdmin(orgId) ||
        isBranchManagerOf(orgId, branchId) ||
        (inOrg(orgId) && request.auth.token.role == 'employee' &&
          request.auth.uid == employeeUid);
      allow create: if inOrg(orgId) &&
        request.auth.token.role in ['employee', 'branchManager'] &&
        request.auth.uid == employeeUid &&
        hasBranch(branchId) &&
        validImage();
    }

    // Evidence objects must use the uploader's own user path. The off-site
    // work operation verifies that the caller is the assigned person before
    // saving a reference. Managers can read evidence in their scope.
    match /organizations/{orgId}/off-site-work-evidence/{branchId}/{employeeUid}/{assignmentId}/{file} {
      allow get: if isOrgAdmin(orgId) ||
        isBranchManagerOf(orgId, branchId) ||
        (inOrg(orgId) && request.auth.token.role == 'employee' &&
          request.auth.uid == employeeUid);
      allow create: if inOrg(orgId) &&
        request.auth.token.role in ['employee', 'branchManager'] &&
        request.auth.uid == employeeUid &&
        hasBranch(branchId) &&
        validImage();
    }

    match /organizations/{orgId}/return-bills/{file} {
      allow get: if inOrg(orgId);
      allow create: if inOrg(orgId) && validImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
